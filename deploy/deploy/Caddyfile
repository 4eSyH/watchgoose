# Caddy — единственная дверь снаружи.
#
# ⚠️ До него всё работало открытым HTTP: интерфейс, API, MCP и приём
# телеметрии. Токены ходили незашифрованными и читались любым, кто
# оказался на пути.
#
# Здесь три двери под одним сертификатом:
#
#   :443   интерфейс, REST API и MCP
#   :4317  приём OTLP по gRPC
#   :4318  приём OTLP по HTTP
#
# ⚠️ Сертификат выпускается автоматически, но для этого нужен доступ
# снаружи: запись DNS на этот адрес и открытые порты 80 и 443. В закрытом
# контуре автоматика не сработает — там свой сертификат (WG_TLS_MODE=own)
# или работа без шифрования (off), и это осознанный выбор, а не умолчание.
#
# Значения подставляются из окружения при разборе файла; их выставляет
# install.sh по выбранному режиму:
#
#   WG_SITE_SCHEME       пусто для TLS, «http://» для работы без шифрования
#   WG_TLS_LINE          пусто для Let's Encrypt, «tls /certs/…» для своего
#   WG_ACME_EMAIL_LINE   «email admin@example.ru» либо пусто

{
	# ⚠️ Обе строки — целиком из окружения, вместе с именем настройки.
	#
	# Подставлять только значение нельзя: «email» с пустым значением
	# Caddy считает ошибкой разбора и не запускается вовсе. А почта
	# нужна лишь при выпуске через Let's Encrypt — при своём сертификате
	# и при работе без шифрования её нет и быть не должно.
	{$WG_ACME_EMAIL_LINE}
	{$WG_ACME_CA_LINE}
}

# ── Интерфейс, API и MCP ────────────────────────────────────────────────────
{$WG_SITE_SCHEME}{$WG_DOMAIN} {
	{$WG_TLS_LINE}

	# ⚠️ Заголовок ставится только на запросы, пришедшие по TLS.
	#
	# Блок сайта один на все режимы, а в режиме без шифрования (off)
	# браузер такой заголовок по открытому HTTP всё равно игнорирует.
	# Отправлять его туда незачем, а вот с адресом, который однажды
	# ответит по https, — обязательно: без него набранное без схемы имя
	# хоста каждый раз уходит открытым HTTP, и посредник на пути
	# подменяет страницу входа, забирая введённый токен.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# ⚠️ /metrics наружу не отдаём вовсе.
	#
	# Маршрут отдаёт имена сервисов, объёмы логов по уровням, состояние
	# детекторов, признак открытого приёма телеметрии и хеш коммита
	# сборки — готовую карту контура любому, кто откроет адрес. Проверку
	# доступа на него не поставить: сборщик метрик токена не носит.
	#
	# Второй рубеж, а не единственный: с версии, где появился
	# server.metrics_addr, /metrics вынесен на отдельный порт 9090, которого
	# нет ни в ports docker-compose, ни здесь, и на 8080 его больше нет
	# вовсе (deploy/docker-compose.yml, deploy/scrape.yml). Матчер оставлен
	# намеренно: он закрывает адрес и в той установке, где metrics_addr
	# оставили пустым. Отвечаем 404, а не 403: существование адреса тоже
	# подсказка.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# ⚠️ Поток событий (/tail) держится открытым минутами и отдаётся
	# порциями. Буферизация ответа превратила бы живое обновление
	# в тишину до самого разрыва соединения.
	reverse_proxy watchgoose:8080 {
		flush_interval -1
	}

	log {
		output stderr
		format console
	}
}

# ── Приём OTLP по gRPC ──────────────────────────────────────────────────────
#
# ⚠️ h2c обязателен: gRPC работает поверх HTTP/2, и без этой пометки
# Caddy пошёл бы к коллектору обычным HTTP/1.1, а тот такой запрос
# не понимает. Снаружи при этом остаётся обычный TLS с HTTP/2.
{$WG_SITE_SCHEME}{$WG_DOMAIN}:4317 {
	{$WG_TLS_LINE}
	reverse_proxy h2c://otel-collector:4317
}

# ── Приём OTLP по HTTP ──────────────────────────────────────────────────────
{$WG_SITE_SCHEME}{$WG_DOMAIN}:4318 {
	{$WG_TLS_LINE}
	reverse_proxy otel-collector:4318
}
