# Образ из ГОТОВОГО бинарника, скачанного из релиза.
#
# ⚠️ Здесь НЕТ сборки Go, и это главное.
#
# Исходники приватные и наружу не уходят. Наружу уходит бинарник,
# выложенный в релиз GitHub по версиям. Установщик скачивает нужную
# сборку под архитектуру машины, проверяет её контрольную сумму
# и заворачивает вот этим файлом в образ — локально, на самом сервере.
#
# Следствие: реестр контейнеров не нужен вовсе. Ни GHCR, ни своего:
# одна публичная страница релизов закрывает раздачу целиком, а образ
# каждый собирает у себя за секунду из уже проверенного бинарника.
#
# Базовый образ тот же, что и у сборки из исходников, чтобы окружение
# внутри контейнера не отличалось: те же сертификаты, та же зона времени,
# тот же непривилегированный пользователь.
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10001 -h /var/lib/watchgoose watchgoose && \
    mkdir -p /var/lib/watchgoose/wal && \
    chown -R watchgoose:watchgoose /var/lib/watchgoose

# Путь к скачанному бинарнику передаёт установщик: имя файла зависит
# от версии и архитектуры, зашивать его сюда нельзя.
ARG BINARY=watchgoose
COPY ${BINARY} /watchgoose
RUN chmod 0755 /watchgoose

USER watchgoose
WORKDIR /var/lib/watchgoose

EXPOSE 8080 4317 4318

ENTRYPOINT ["/watchgoose"]
CMD ["--role=all"]
